# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# LLM — OpenRouter (single gateway for GPT / Claude / Gemini / etc.)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_SITE_URL=https://echowrite.app
OPENROUTER_APP_NAME=EchoWrite
DEFAULT_LLM=gpt-4o-mini

# Optional — only needed for embeddings fallback, not chat
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Creem (https://creem.io) — billing / subscriptions
# Get these from Creem Dashboard → Developers + Products
CREEM_API_KEY=creem_test_...
CREEM_WEBHOOK_SECRET=whsec_...
CREEM_PRODUCT_PRO=prod_...
CREEM_PRODUCT_TEAM=
CREEM_TEST_MODE=true
CREEM_SUCCESS_URL=https://echowrite.app?checkout=success

# App
FRONTEND_URL=https://echowrite.app
CORS_ORIGINS=chrome-extension://your-extension-id,https://echowrite.app
